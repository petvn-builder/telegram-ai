# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Google (Calendar + Gmail MCP) ─────────────────────────────────────────────
# Create an OAuth 2.0 Web Client in Google Cloud Console.
# Add the redirect URI (below) to the client's Authorized redirect URIs.
# Enable the "Google Calendar API" and "Gmail API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 32 bytes as hex (64 hex chars). Used for AES-256-GCM at-rest encryption of
# stored access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Only used by the standalone stdio MCP server (mcp/server.ts) when running
# outside Next.js (e.g. Claude Desktop). Points at the Supabase user whose
# Google tokens the MCP server should use.
BRAINOS_MCP_USER_ID=
# IANA timezone for date parsing (e.g. "Asia/Ho_Chi_Minh"). Defaults to UTC.
BRAINOS_MCP_TIMEZONE=
